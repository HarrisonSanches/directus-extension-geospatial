{
	"name": "directus-extension-geospatial-spikes-layout",
	"version": "0.0.0",
	"private": true,
	"description": "The layout of the proofs of F01-14 and F01-15, which loads MapLibre, deck.gl and Terra Draw only when they are needed, with the route that serves the worker of MapLibre, and never ships.",
	"license": "MIT",
	"type": "module",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "layout",
				"name": "geospatial-spike-map",
				"source": "src/index.ts"
			},
			{
				"type": "endpoint",
				"name": "geospatial-spikes-layout",
				"source": "src/endpoint.ts"
			}
		],
		"host": "^11.17.0 || ^12.4.0"
	},
	"scripts": {
		"build": "directus-extension build"
	},
	"devDependencies": {
		"@deck.gl/core": "catalog:",
		"@deck.gl/geo-layers": "catalog:",
		"@deck.gl/layers": "catalog:",
		"@deck.gl/maplibre": "catalog:",
		"@directus/extensions-sdk": "catalog:",
		"@loaders.gl/mvt": "catalog:",
		"@types/node": "catalog:node22",
		"maplibre-gl": "catalog:",
		"terra-draw": "catalog:",
		"terra-draw-maplibre-gl-adapter": "catalog:",
		"vue": "catalog:"
	}
}
