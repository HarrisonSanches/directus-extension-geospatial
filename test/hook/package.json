{
	"name": "directus-extension-geospatial-test-hook",
	"version": "0.0.0",
	"private": true,
	"description": "Another extension for the integration suite, whose hooks on items.query change the query of a collection of its own.",
	"license": "MIT",
	"type": "module",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "geospatial-test-hook",
				"source": "src/hook.ts"
			},
			{
				"type": "endpoint",
				"name": "geospatial-test-hook-calls",
				"source": "src/endpoint.ts"
			}
		],
		"host": "^11.17.0 || ^12.4.0"
	},
	"scripts": {
		"build": "directus-extension build --no-minify"
	},
	"devDependencies": {
		"@directus/errors": "catalog:",
		"@directus/extensions-sdk": "catalog:",
		"@directus/types": "catalog:",
		"@types/node": "catalog:node22",
		"knex": "catalog:",
		"pino": "catalog:"
	}
}
