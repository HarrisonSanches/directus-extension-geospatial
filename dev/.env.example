# The development environment of the extension. Copy this file to dev/.env and run pnpm dev.
#
# The secrets stay empty here: on each start, pnpm dev generates the ones that are empty in dev/.env and keeps the
# ones that already have a value. The database and the admin are created with them on the first start, so a new
# value only takes effect after pnpm dev:down --volumes, which also deletes the data.
#
# The license key of Directus 12 does not go here: apply it in the Studio, as dev/compose.yaml explains.

# Ports on 127.0.0.1, the only address the environment listens on.
DIRECTUS_PORT=8055
DATABASE_PORT=5432

# Postgres password of the directus user.
DB_PASSWORD=

# Signs the sessions and tokens of Directus.
SECRET=

# The admin created on the first start. The token authenticates API calls as the admin:
#   curl -H "Authorization: Bearer <ADMIN_TOKEN>" http://127.0.0.1:8055/geospatial/capabilities
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_TOKEN=
