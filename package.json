{
	"name": "directus-extension-geospatial-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"lint": "eslint --max-warnings 0 .",
		"prepare": "husky",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc && tsc -p packages/contract && tsc -p packages/extension"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/lint": "catalog:",
		"@commitlint/load": "catalog:",
		"@commitlint/types": "catalog:",
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-import-x": "catalog:",
		"husky": "catalog:",
		"jiti": "catalog:",
		"knip": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@12.5.1",
	"engines": {
		"pnpm": "^12.5.1"
	}
}
